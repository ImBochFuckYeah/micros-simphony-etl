{
  "name": "micros-simphony-etl",
  "version": "1.0.0",
  "description": "Automated integration service built with Node.js to fetch Oracle MICROS Simphony POS sales data (JSON) via SFTP, persist it in SQL Server, and sync it to SAP Business One via Service Layer.",
  "main": "dist/app.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/app.ts",
    "manual-sync": "tsx -e \"import { processMicrosFilesOnce } from './src/jobs/nightlySyncJob.ts'; (async () => { await processMicrosFilesOnce(process.env.START_DATE, process.env.END_DATE); })();\"",
    "manual-sap-sync": "tsx -e \"import { processPendingInvoicesInSapOnce } from './src/jobs/nightlySyncJob.ts'; (async () => { await processPendingInvoicesInSapOnce(process.env.START_DATE, process.env.END_DATE); })();\"",
    "manual-pedidos-sync": "tsx -e \"import { processPedidosFilesOnce } from './src/jobs/nightlySyncJob.ts'; (async () => { await processPedidosFilesOnce(process.env.START_DATE, process.env.END_DATE); })();\"",
    "manual-consumos-sync": "tsx -e \"import { processConsumosFilesOnce } from './src/jobs/nightlySyncJob.ts'; (async () => { await processConsumosFilesOnce(process.env.START_DATE, process.env.END_DATE); })();\"",
    "manual-full-sync": "tsx -e \"import { runFullIntegrationOnce } from './src/jobs/nightlySyncJob.ts'; (async () => { await runFullIntegrationOnce(process.env.START_DATE, process.env.END_DATE); })();\"",
    "start": "node dist/app.js",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImBochFuckYeah/micros-simphony-etl.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ImBochFuckYeah/micros-simphony-etl/issues"
  },
  "homepage": "https://github.com/ImBochFuckYeah/micros-simphony-etl#readme",
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1",
    "node-cron": "^4.2.1",
    "pg": "^8.22.0",
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/ssh2-sftp-client": "^9.0.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
